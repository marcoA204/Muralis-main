PROJECT_NAME="Muralis API"
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://muralis_user:muralis_password@localhost:5432/muralis_db"

# JWT Auth
JWT_SECRET="muralis_super_secret_jwt_key_2026"
REFRESH_SECRET="muralis_super_secret_refresh_key_2026"
ACCESS_TOKEN_EXPIRE_DAYS=1
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO / AWS S3
S3_BUCKET="muralis-assets"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_FORCE_PATH_STYLE=true
